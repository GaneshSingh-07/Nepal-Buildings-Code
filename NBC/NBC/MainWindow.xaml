
<Window x:Class="NBC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nepal Buildings Code"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style for the small "?" ("What") button that reveals the NBC 105:2025 clause upon mouse hover -->
        <Style x:Key="WhatButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Content" Value="?"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Shows the NBC 105:2025 clause tooltip after 100ms and keeps it open for 60 seconds -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="badgeBorder" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="badgeBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for the ToolTip popup box to format NBC 105:2025 clause explanations cleanly -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MaxWidth" Value="430"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ScrollViewer allows smooth vertical scrolling across all resolution sizes -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <Grid>
            <!-- Two main columns: Left (Inputs & Full Table 5-2), Right (Results & ETABS Integration) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT PANEL: INPUTS & FULL TABLE 5-2 ==================== -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                <!-- Header Banner -->
                <Border Background="#1E3A8A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="NBC 105:2025 — Equivalent Static Method &amp; ETABS Automation"
                                   Foreground="White" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Hover over any '?' button to view the governing NBC 105:2025 clause, table, and equation."
                                   Foreground="#BFDBFE" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 1: SEISMIC HAZARD, SEARCHABLE CITY & MANUAL Z (SECTION 4) -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="1. Seismic Hazard &amp; Site Parameters (Section 4 &amp; Annex C)"
                                   FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <!-- Row 1a: Searchable City / Municipality Filter + Dropdown -->
                        <!-- Syntax Example: <TextBox Text="{Binding CitySearchText, UpdateSourceTrigger=PropertyChanged}"/> -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Search City / Municipality:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <!-- Search box filters the City/Municipality dropdown in real time as the user types -->
                            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,6,0"
                                     Text="{Binding CitySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Type city or district name (e.g., Kathmandu, Dhangadhimai, Pokhara, Dharan) to filter Annex C list"/>
                            <!-- Filtered ComboBox of cities from Annex C (Table C-1) -->
                            <ComboBox Grid.Column="2" Height="28" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding FilteredCities}"
                                      SelectedItem="{Binding SelectedCity, Mode=TwoWay}"/>
                            <Button Grid.Column="3" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 4.1.4 &amp; Annex C (Table C-1):&#x0a;Type in the search box to filter municipalities/cities from Annex C (Table C-1). Selecting a city automatically populates the Seismic Zoning Factor (Z) below."/>
                        </Grid>

                        <!-- Row 1b: Manual / Active Seismic Zoning Factor (Z) Input -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Seismic Zoning Factor, Z (Manual):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <!-- Allows the user to manually type any Z value (or use the value auto-filled by the selected city) -->
                            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontWeight="Bold" Foreground="#1E40AF"
                                     Text="{Binding ManualZText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="(Auto-filled by city selection, or type any manual Z value)"
                                       VerticalAlignment="Center" Foreground="#64748B" FontSize="11.5" Margin="8,0,0,0"/>
                            <Button Grid.Column="3" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 4.1.4 (Figure 4-3 &amp; Annex C Table C-1):&#x0a;The Seismic Zoning Factor (Z) represents Peak Ground Acceleration (PGA) for a 475-year return period. You can select a municipality above OR manually enter Z (e.g., 0.25, 0.30, 0.35, 0.40, or interpolated from Figure 4-3)."/>
                        </Grid>

                        <!-- Row 2: Site Subsoil Category -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Site Subsoil Category:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding SoilTypes}"
                                      SelectedItem="{Binding SelectedSoilType, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 4.1.2 (Table 4-1) &amp; Clause 4.1.3 (Table 4-2 &amp; Table 4-3):&#x0a;• Type A (Rock, Vs,30 &gt; 800 m/s): Tc=0.5s, Td=4.0s, α=2.5&#x0a;• Type B (Very dense sand/stiff clay, 350 &lt; Vs,30 ≤ 800 m/s): Tc=0.7s, Td=4.0s, α=2.5&#x0a;• Type C (Medium dense sand/stiff clay, 150 &lt; Vs,30 ≤ 350 m/s): Tc=1.0s, Td=4.0s, α=2.5&#x0a;• Type D (Loose/soft soil, Vs,30 ≤ 150 m/s &amp; specified Kathmandu Valley wards in Table 4-3): Tc=2.0s, Td=5.0s, α=2.25.&#x0a;Note: Ta = 0 for Equivalent Static Method."/>
                        </Grid>

                        <!-- Row 3: Importance Class & Factor (I) -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Building Importance Class (I):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding ImportanceClasses}"
                                      SelectedItem="{Binding SelectedImportance, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 4.1.5 (Table 4-4):&#x0a;• Class I (I = 1.0): Ordinary structures (residences, apartments, offices, commercial &lt; 500 persons).&#x0a;• Class II (I = 1.25): Schools, colleges, cinemas, malls, temples, police stations, water works, assembly &gt; 500 persons (Use I = 1.5 if used as a disaster shelter per Footnote 2).&#x0a;• Class III (I = 1.5): Hospitals, fire stations, police HQ, air traffic control, power stations."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: GEOMETRY, PERIOD & ACCIDENTAL ECCENTRICITY (CLAUSE 5.1 & 5.6) -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="2. Geometry, Time Period &amp; Accidental Eccentricity (Clauses 5.1 &amp; 5.6)"
                                   FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <!-- Row 1: Building Height H and Accidental Eccentricity -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Building Height, H (m):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding HeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}" Margin="6,0,14,0"
                                    ToolTip="Clause 5.1.2 (Figure 5-1) &amp; Clause 3.2.1:&#x0a;Height (H) in meters from the base to the top of the roof level. Used in empirical period T1 = 1.25 * kt * H^(3/4) and ESM applicability check."/>

                            <TextBlock Grid.Column="3" Text="Accidental Eccentricity (e/b):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="4" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontWeight="Bold" Foreground="#0F766E"
                                     Text="{Binding EccentricityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="5" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 5.6 &amp; Clause 6.4:&#x0a;For analysis of torsional effects, the applied torsion at each level shall use forces applied through points eccentric to the center of mass by an accidental eccentricity of ±0.05b (i.e., ratio = 0.05 or 5% of diaphragm dimension b). This value is sent directly to ETABS."/>
                        </Grid>

                        <!-- Row 2: Building Regularity -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Building Configuration:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding RegularityOptions}"
                                      SelectedIndex="{Binding SelectedRegularityIndex, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 3.2.1 &amp; Clause 5.4:&#x0a;Equivalent Static Method (ESM) is applicable for all SLS calculations. For ULS, ESM is permitted when at least one is satisfied:&#x0a;(i) H ≤ 15 m, (ii) T1 &lt; 0.5 sec, or (iii) Structure is NOT irregular (per Clause 5.4) and H &lt; 40 m."/>
                        </Grid>

                        <!-- Row 3: Empirical Period Frame Type (kt) in X-Direction -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Empirical Period Type (kt) — X:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding KtOptionsX}"
                                      SelectedItem="{Binding SelectedKtX, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 5.1.2 (Eq. 5.1(2)) &amp; Clause 5.1.3:&#x0a;Approximate period T1 = 1.25 * kt * H^(3/4), where kt is:&#x0a;• 0.075: Moment resisting concrete frame&#x0a;• 0.085: Moment resisting structural steel frame&#x0a;• 0.075: Eccentrically braced structural steel frame&#x0a;• 0.075 / √Aw: Building with concrete shear walls&#x0a;• 0.050: All other structural systems."/>
                        </Grid>

                        <!-- Row 4: Effective Shear Wall Area Aw in X-Direction -->
                        <Grid Margin="0,0,0,8" Visibility="{Binding AwXVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Effective Wall Area Aw — X (m²):" VerticalAlignment="Center" Foreground="#1E40AF" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding AwXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 5.1.2:&#x0a;For concrete shear wall buildings, kt = 0.075 / √Aw, where Aw = Σ [ Awi * { 0.2 + (Lwi / H)² } ] with Lwi/H ≤ 0.9."/>
                        </Grid>

                        <!-- Row 5: Empirical Period Frame Type (kt) in Y-Direction -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Empirical Period Type (kt) — Y:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding KtOptionsY}"
                                      SelectedItem="{Binding SelectedKtY, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 5.1.2 (Eq. 5.1(2)) &amp; Clause 5.1.3:&#x0a;Selects empirical coefficient kt along the Y orthogonal direction, amplified by 1.25 per Clause 5.1.3."/>
                        </Grid>

                        <!-- Row 6: Effective Shear Wall Area Aw in Y-Direction -->
                        <Grid Margin="0,0,0,8" Visibility="{Binding AwYVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Effective Wall Area Aw — Y (m²):" VerticalAlignment="Center" Foreground="#1E40AF" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding AwYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 5.1.2:&#x0a;For concrete shear wall buildings in Y direction, kt = 0.075 / √Aw, where Aw = Σ [ Awi * { 0.2 + (Lwi / H)² } ] with Lwi/H ≤ 0.9."/>
                        </Grid>

                        <!-- Row 7: Optional Rayleigh Period Comparison -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Compare Rayleigh T (s):" VerticalAlignment="Center" FontWeight="SemiBold"
                                      IsChecked="{Binding UseRayleigh, Mode=TwoWay}"/>
                            <TextBox Grid.Column="1" Height="28" Margin="0,0,4,0" VerticalContentAlignment="Center" Padding="6,0"
                                     IsEnabled="{Binding UseRayleigh}" ToolTip="Rayleigh Period Tx (sec)"
                                     Text="{Binding RayleighXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Height="28" Margin="4,0,0,0" VerticalContentAlignment="Center" Padding="6,0"
                                     IsEnabled="{Binding UseRayleigh}" ToolTip="Rayleigh Period Ty (sec)"
                                     Text="{Binding RayleighYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="3" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="Clause 5.1 &amp; Clause 5.1.1 (Eq. 5.1(1)):&#x0a;The amplified empirical period (Clause 5.1.3) shall be compared with the Rayleigh period T1 = 2π √[ Σ(Wi*di²) / (g*Σ(Fi*di)) ], and the LESSER value of the two shall be adopted."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: FULL INTERACTIVE NBC 105:2025 TABLE 5-2 SELECTOR (CLAUSE 5.3) -->
                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="3. NBC 105:2025 Table 5-2: Ductility (Rμ) &amp; Overstrength (Ωu, Ωs) Selector"
                                       FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource WhatButtonStyle}" HorizontalAlignment="Right"
                                    ToolTip="Clause 5.3.1 to 5.3.4 &amp; Table 5-2:&#x0a;Full Table 5-2 from NBC 105:2025. Check 'EQX' or 'EQY' on any row in the table below to assign that structural system's Rμ, Ωu, and Ωs to the X or Y direction. Different structural systems are permitted in orthogonal directions per Clause 5.3.4. Note: Rs = 1.0 for SLS per Clause 5.3.2.2."/>
                        </DockPanel>

                        <TextBlock Text="Click the 'EQX' or 'EQY' checkbox on any row of Table 5-2 below to select the structural system for X and Y directions:"
                                   FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>

                        <!-- DataGrid displaying the entire 21-row Table 5-2 from NBC 105:2025 -->
                        <!-- Syntax Example: <DataGrid ItemsSource="{Binding Table5_2Rows}" AutoGenerateColumns="False"/> -->
                        <DataGrid ItemsSource="{Binding Table5_2Rows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  VerticalGridLinesBrush="#E2E8F0"
                                  RowHeight="27"
                                  Height="270"
                                  FontSize="12"
                                  Background="White"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <!-- Column 1: Select for EQX -->
                                <DataGridTemplateColumn Header="EQX" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelectedX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Column 2: Select for EQY -->
                                <DataGridTemplateColumn Header="EQY" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelectedY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Column 3: S. No. -->
                                <DataGridTextColumn Header="S.No." Binding="{Binding SerialNo}" Width="45" IsReadOnly="True"/>

                                <!-- Column 4: System Category -->
                                <DataGridTextColumn Header="System Category" Binding="{Binding Category}" Width="145" IsReadOnly="True"/>

                                <!-- Column 5: Structural System Name -->
                                <DataGridTextColumn Header="Structural System (Table 5-2)" Binding="{Binding SystemName}" Width="*" IsReadOnly="True"/>

                                <!-- Column 6: R_mu -->
                                <DataGridTextColumn Header="Rμ" Binding="{Binding R_mu}" Width="48" IsReadOnly="True" FontWeight="Bold"/>

                                <!-- Column 7: Omega_u -->
                                <DataGridTextColumn Header="Ωu" Binding="{Binding Omega_u}" Width="48" IsReadOnly="True" FontWeight="Bold"/>

                                <!-- Column 8: Omega_s -->
                                <DataGridTextColumn Header="Ωs" Binding="{Binding Omega_s}" Width="48" IsReadOnly="True" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Active Selection Summary Banner under Table 5-2 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedSystemXSummary}" FontWeight="SemiBold" Foreground="#1E40AF" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedSystemYSummary}" FontWeight="SemiBold" Foreground="#991B1B" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== RIGHT PANEL: RESULTS & ETABS AUTOMATION ==================== -->
            <StackPanel Grid.Column="1">

                <!-- ESM Applicability Status Banner -->
                <Border Background="{Binding ApplicabilityBackground}" BorderBrush="{Binding ApplicabilityBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ApplicabilityMessage}"
                               Foreground="{Binding ApplicabilityForeground}"
                               FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- Primary Output Card: The 4 Base Shear Coefficients + "Create ETABS Load" Button -->
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Computed Base Shear Coefficients Cd(T1)" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <Button Style="{StaticResource WhatButtonStyle}" HorizontalAlignment="Right"
                                    ToolTip="Clause 6.1.1 (Eq. 6.1(1)) &amp; Clause 6.1.2 (Eq. 6.1(2)):&#x0a;• ULS Base Shear Coefficient: Cd(T1) = C(T1) / (Rμ × Ωu)&#x0a;• SLS Base Shear Coefficient: Cd(T1) = Cs(T1) / Ωs&#x0a;Horizontal Base Shear V = Cd(T1) × W (Clause 6.2)."/>
                        </DockPanel>

                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,14">
                            <!-- Card 1: EQX SLS -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="EQX — SLS" FontSize="12" FontWeight="Bold" Foreground="#1E40AF"/>
                                    <TextBlock Text="Cd(T1x) = Cs(T1x) / Ωs,x" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding EqxSlsResult}" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: EQY SLS -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="EQY — SLS" FontSize="12" FontWeight="Bold" Foreground="#1E40AF"/>
                                    <TextBlock Text="Cd(T1y) = Cs(T1y) / Ωs,y" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding EqySlsResult}" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: EQX ULS -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,6,0">
                                <StackPanel>
                                    <TextBlock Text="EQX — ULS" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>
                                    <TextBlock Text="Cd(T1x) = C(T1x) / (Rμ,x × Ωu,x)" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding EqxUlsResult}" FontSize="22" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: EQY ULS -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="EQY — ULS" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>
                                    <TextBlock Text="Cd(T1y) = C(T1y) / (Rμ,y × Ωu,y)" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding EqyUlsResult}" FontSize="22" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- CREATE ETABS LOAD BUTTON -->
                        <!-- Syntax Example: <Button Content="Create ETABS Load" Click="CreateEtabsLoad_Click"/> -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Create ETABS Load (EQX ULS, EQY ULS, EQX SLS, EQY SLS)"
                                    Height="40" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13.5"
                                    BorderThickness="0" Cursor="Hand" Click="CreateEtabsLoad_Click"/>
                            <Button Grid.Column="1" Style="{StaticResource WhatButtonStyle}"
                                    ToolTip="ETABS Open API Automation (Clauses 3.3, 5.6, 6.1, 6.3):&#x0a;Connects to your currently open ETABS instance and creates 4 Seismic (Quake) Load Patterns &amp; Linear Static Cases with User-Defined Coefficients:&#x0a;• EQX ULS &amp; EQX SLS: Global X-Direction only (DirFlag = 1)&#x0a;• EQY ULS &amp; EQY SLS: Global Y-Direction only (DirFlag = 2)&#x0a;• Eccentricity Ratio: Uses your entered Accidental Eccentricity (e.g., 0.05)&#x0a;• Base Shear Coefficient c = Cd(T1) and Exponent k = kx or ky."/>
                        </Grid>

                        <!-- ETABS Status Message Box -->
                        <TextBlock Text="{Binding EtabsStatusMessage}" Foreground="{Binding EtabsStatusBrush}"
                                   FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Step-by-Step Intermediate Code Parameters Breakdown -->
                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Step-by-Step NBC 105:2025 Parameter Breakdown"
                                   FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding BreakdownText, Mode=OneWay}" IsReadOnly="True"
                                 Background="#F8FAFC" BorderBrush="#E2E8F0"
                                 FontFamily="Consolas" FontSize="11.5" Padding="10" Height="390"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>